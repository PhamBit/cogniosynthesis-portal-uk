---
interface Props {
  heading?: string;
  intro?: string;
  partners: { name: string; logo: string }[];
  class?: string;
}

const { 
  heading, 
  intro = 'Trusted by leading organizations worldwide',
  partners = [],
  class: className = ''
} = Astro.props;
---

<section class={`partners-section section section--light ${className}`}>
  <div class="container">
    {heading && (
      <h2 class="section__heading heading--h2">{heading}</h2>
    )}
    
    <p class="section__intro text--body-lg">{intro}</p>
    
    <div class="partner-logos">
      {partners.map(partner => (
        <div class="partner-logo-item">
          <img 
            src={partner.logo} 
            alt={`${partner.name} logo`}
            class="partner-logo"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners-section {
    padding: var(--spacing-80) 0;
    background-color: var(--color-background-surface);
  }
  
  .section__intro {
    text-align: center;
    font-size: var(--fontsize-body-lg);
    color: #4b4d5d;
    margin-bottom: var(--spacing-48);
  }
  
  .partner-logos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-32) var(--spacing-40);
    align-items: center;
    justify-items: center;
    
    @media (min-width: 768px) {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-40) var(--spacing-56);
    }
    
    @media (min-width: 1024px) {
      gap: var(--spacing-48) var(--spacing-64);
    }
  }
  
  .partner-logo-item {
    width: 160px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .partner-logo {
    max-width: 100%;
    max-height: 100%;
    filter: grayscale(100%);
    opacity: 0.65;
    transition: filter 200ms ease-in-out, opacity 200ms ease-in-out, transform 200ms ease-in-out;
    cursor: pointer;
    
    &:hover {
      filter: grayscale(0%);
      opacity: 1;
      transform: scale(1.05);
    }
  }
</style>
