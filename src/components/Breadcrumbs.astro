---
/**
 * Breadcrumbs component - shows navigation path
 */

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  crumbs?: Crumb[];
}

const { crumbs = [] } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs-list">
    <li class="breadcrumbs-item breadcrumbs-item--home">
      <a href="/" class="breadcrumbs-link">Home</a>
    </li>
    {crumbs.map((crumb, index) => (
      <>
        <li class="breadcrumbs-separator">/</li>
        {index === crumbs.length - 1 ? (
          <li class="breadcrumbs-item breadcrumbs-item--current" aria-current="page">
            <span class="breadcrumbs-text">{crumb.label}</span>
          </li>
        ) : (
          <li class="breadcrumbs-item">
            <a href={crumb.href} class="breadcrumbs-link">{crumb.label}</a>
          </li>
        )}
      </>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: var(--spacing-24);
  }
  
  .breadcrumbs-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--spacing-4);
    font-size: var(--fontsize-body-sm);
  }
  
  .breadcrumbs-item {
    display: flex;
    align-items: center;
  }
  
  .breadcrumbs-item--current .breadcrumbs-text {
    color: #4b4d5d;
  }
  
  .breadcrumbs-separator {
    color: #dcdce0;
    margin: 0 var(--spacing-8);
  }
  
  .breadcrumbs-link {
    color: #2f6fd5;
    text-decoration: none;
    transition: color 150ms ease-in-out;
  }
  
  .breadcrumbs-link:hover {
    color: #1a5bb8;
    text-decoration: underline;
  }
  
  .breadcrumbs-item--home .breadcrumbs-link svg {
    width: 16px;
    height: 16px;
  }
</style>
