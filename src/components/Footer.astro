---
import { EMAIL, PHONE_DISPLAY, PHONE_HREF, ICO_NUMBER, ICO_HREF, COMPANY_LINE } from '../data/site';

const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { href: '/explore/', label: 'AI Exploration' },
    { href: '/health-check/', label: 'AI Health Check' },
    { href: '/audits/', label: 'Epistemic Audit' }
  ],
  company: [
    { href: '/about', label: 'About Us' },
    { href: '/products/', label: 'Products' },
    { href: '/sovereign-data/', label: 'Sovereign Data Policy' },
    { href: 'https://cognionews.com/', label: 'CognioNews' }
  ],
  contact: [
    { href: '/contact', label: 'Book a conversation' },
    { href: `mailto:${EMAIL}`, label: EMAIL },
    { href: PHONE_HREF, label: `Tel ${PHONE_DISPLAY}` }
  ]
};
---

<footer class="footer">
  <div class="container">
    <!-- Company Info + Links -->
    <div class="footer-content">
      <div class="footer-company-info">
        <div class="footer-logo-slogan">
          <svg width="180" height="32" viewBox="0 0 240 40" fill="none" aria-hidden="true">
            <text x="0" y="24" font-family="GT Standard Extended, system-ui" font-size="16" font-weight="600" fill="currentColor">
              CognioSynthesis
            </text>
          </svg>
        </div>
        <p class="footer-description">
          Digital ecosystem support, analytics and reporting. AI Exploration, AI Health Check and Epistemic Audit: in your building, offline.
        </p>
      </div>
      
      <div class="footer-column">
        <h4 class="footer-heading">Services</h4>
        <ul class="footer-links">
          {footerLinks.services.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      
      <div class="footer-column">
        <h4 class="footer-heading">Company</h4>
        <ul class="footer-links">
          {footerLinks.company.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      
      <div class="footer-column">
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-links">
          {footerLinks.contact.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="footer-copyright">
      <p class="footer-copyright-text">
        © {currentYear} {COMPANY_LINE}
      </p>
      <p class="footer-copyright-text">
        Registered with the Information Commission: <a href={ICO_HREF} rel="noopener">{ICO_NUMBER}</a>
      </p>
      
      <nav class="footer-legal" aria-label="Legal links">
        <a href="/privacy">Privacy Policy</a>
        <span class="footer-divider">•</span>
        <a href="/terms">Terms of Service</a>
        <span class="footer-divider">•</span>
        <a href="/cookies">Cookie Policy</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-background-surface);
    color: var(--color-text-primary);
    padding: var(--spacing-64) 0 var(--spacing-32);
    border-top: 1px solid var(--color-border-subtle);
  }
  
  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-40);
    padding-bottom: var(--spacing-40);
    
    @media (min-width: 768px) {
      grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
      gap: var(--spacing-48);
    }
  }
  
  .footer-company-info {
    max-width: 400px;
  }
  
  .footer-description {
    font-size: var(--fontsize-body-sm);
    line-height: var(--line-height-body-md);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-24);
  }
  
  .footer-logo-slogan {
    margin-top: var(--spacing-16);
  }
  
  .footer-heading {
    font-size: var(--fontsize-body-sm);
    font-weight: 600;
    margin-bottom: var(--spacing-16);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    
    li {
      margin-bottom: var(--spacing-12);
    }
    
    a {
      color: var(--color-text-secondary);
      font-size: var(--fontsize-body-sm);
      line-height: var(--line-height-body-md);
      transition: color 150ms ease-in-out;
      text-decoration: none;
      
      &:hover {
        color: var(--color-primary-blue);
      }
    }
  }
  
  .footer-copyright {
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: var(--spacing-40);
    
    @media (min-width: 768px) {
      grid-column: 1 / -1;
      padding-top: var(--spacing-24);
      border-top: 1px solid var(--color-border-subtle);
      margin-top: var(--spacing-40);
    }
  }
  
  .footer-copyright-text {
    font-size: var(--fontsize-body-xs);
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-8);
  }

  .footer-copyright-text a {
    color: inherit;
    text-decoration: underline;
  }
  
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-16);
    margin-top: var(--spacing-16);
    
    a {
      font-size: var(--fontsize-body-xs);
      color: var(--color-text-secondary);
      text-decoration: none;
      transition: color 150ms ease-in-out;
      
      &:hover {
        color: var(--color-primary-blue);
      }
    }
  }
  
  .footer-divider {
    color: var(--color-border-default);
  }
</style>
