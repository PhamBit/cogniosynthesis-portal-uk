---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Digital ecosystem support, analytics and reporting: AI Exploration, AI Health Check and Epistemic Audit. In your building, offline. Every one starts with a free 45-minute conversation.' } = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={Astro.url} />
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Meta tags -->
    <title>{title} | CognioSynthesis Portal</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="CognioSynthesis Portal" />
    
    <!-- Fonts are served from this site: no outside request -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-expanded-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/inter.css" />
    <link rel="stylesheet" href="/fonts/archivo-expanded.css" />
  </head>
  <body>
    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <Header />

    <!-- Page title bar (shown on inner pages) -->
    {currentPath !== '/' && (
      <div class="page-title-bar">
        <div class="container">
          <nav aria-label="Breadcrumbs">
            <a href="/" class="home-link" aria-label="Home">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9,22 9,12 15,12 15,22"/>
              </svg>
            </a>
            <span class="breadcrumb-separator">/</span>
            <span class="current-page">{title}</span>
          </nav>
        </div>
      </div>
    )}
    
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  /* Page title bar (breadcrumbs area) */
  .page-title-bar {
    background-color: #f6f3f0;
    border-bottom: 1px solid #e0dcd8;
    padding: var(--spacing-16) 0;
    font-size: var(--fontsize-body-sm);
  }
  
  .page-title-bar nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }
  
  .home-link {
    display: flex;
    align-items: center;
    color: #2f6fd5;
    transition: opacity 150ms ease-in-out;
  }
  
  .home-link:hover {
    opacity: 0.8;
  }
  
  .breadcrumb-separator {
    color: #dcdce0;
  }
  
  .current-page {
    color: #4b4d5d;
  }
</style>
