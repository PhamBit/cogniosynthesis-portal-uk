---
import Layout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { EMAIL } from '../../data/site';

// CognioEnacted is open by application only (Kenny, 27 Nov 2026). The server sends anyone
// without a personal login to this page; the application is a pre-filled email to info@.
const APPLY_MAILTO =
  `mailto:${EMAIL}?subject=Access%20request%3A%20CognioEnacted&body=Name%3A%0AOrganisation%3A%0AWork%20email%3A%0AWhy%20you%20would%20like%20access%3A%0A`;
---

<Layout title="Apply for access to CognioEnacted" description="CognioEnacted maps how well 25 UK legislative instruments address knowledge equity, through the Seven Lenses. Access is by application." noindex={true}>
  <div class="page-hero">
    <div class="container">
      <h1>Apply for access to CognioEnacted</h1>
      <p class="hero-subtitle">CognioEnacted is open by application.</p>
    </div>
  </div>

  <section class="section section--alt">
    <div class="container apply-wrap">
      <div class="apply-card">
        <h2>What CognioEnacted is</h2>
        <p>CognioEnacted maps epistemic completeness in UK legislation through the Seven Lenses: how well 25 legislative instruments address knowledge equity.</p>

        <h2>How to apply</h2>
        <p>The button opens an email with these headings ready to fill in:</p>
        <ul class="apply-fields">
          <li>Name</li>
          <li>Organisation</li>
          <li>Work email</li>
          <li>Why you would like access</li>
        </ul>
        <a href={APPLY_MAILTO} class="btn btn-primary btn-lg">Email to apply for access</a>
        <p class="apply-small">If the button does not open your email, write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a> with "Access request: CognioEnacted" as the subject.</p>
        <p class="apply-small">We read every application. If access is granted, we send you a personal login by email.</p>

        <h2>Already have a login?</h2>
        <p><a href="/enacted/">Open CognioEnacted</a>. Your browser will ask for your username and password.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-hero h1 { font-size: clamp(30px, 9vw, 48px); line-height: 1.15; }
  .apply-wrap { max-width: 760px; }
  .apply-card {
    background: #ffffff;
    border: 1px solid #dcdce0;
    border-radius: 12px;
    padding: 32px;
  }
  .apply-card h2 { margin-top: 1.4em; }
  .apply-card h2:first-child { margin-top: 0; }
  .apply-fields { list-style: disc; padding-left: 1.4em; margin: 0.6em 0 1.2em; }
  .apply-card .btn { max-width: 100%; white-space: normal; text-align: center; }
  .apply-small { font-size: 0.95em; margin-top: 1em; }
  @media (max-width: 420px) { .apply-card { padding: 24px; } }
</style>
