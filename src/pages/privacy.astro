---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
// The wording is the live page's own, held whole in src/data/legal/privacy.html
// (taken from https://cogniosynthesisportal.uk/privacy.html on 26 Nov 2026). Edit it there.
import legal from '../data/legal/privacy.html?raw';
---

<BaseLayout title="Privacy Policy" description="How Cogniosynthesis Portal Ltd collects, uses, shares and protects personal data, our lawful bases, retention periods, cookies and your UK GDPR rights.">
  <div class="container section legal-content" set:html={legal} />
  <Footer />
</BaseLayout>

<style is:global>
  /* The wording arrives as ready-made HTML, so its styles cannot be scoped. */
  .legal-content { max-width: 860px; }
  .legal-content h1 { margin-bottom: var(--spacing-32); }
  .legal-content h2 { margin-top: var(--spacing-48); margin-bottom: var(--spacing-16); font-size: clamp(20px, 3vw, 26px); line-height: 1.3; }
  .legal-content h3 { margin-top: var(--spacing-24); margin-bottom: var(--spacing-12); font-size: 18px; line-height: 1.4; }
  .legal-content p, .legal-content li { margin-bottom: var(--spacing-12); line-height: 1.7; }
  .legal-content ul { list-style: disc; padding-left: 22px; }
  .legal-content a { color: #1f57b3; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .legal-content table { width: 100%; border-collapse: collapse; margin: var(--spacing-24) 0; font-size: var(--fontsize-body-sm); }
  .legal-content th, .legal-content td { border: 1px solid #dcdce0; padding: 8px; text-align: left; vertical-align: top; }
  .legal-content hr { margin: var(--spacing-48) 0; border: none; border-top: 1px solid var(--color-border-default); }
</style>
