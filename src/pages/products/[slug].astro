---
import Layout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import products from '../../data/products.json';
import { PRODUCT_SITES_NOT_OPEN } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const bySlug = Object.fromEntries(products.map((p) => [p.slug, p]));
const parent = product.parent ? bySlug[product.parent] : null;
const siblings = product.siblings.map((s) => bySlug[s]).filter(Boolean);
const buttons = product.buttons.filter((b) => !PRODUCT_SITES_NOT_OPEN.includes(b.href));
const familyId = product.category.toLowerCase().replace(/[^a-z]+/g, '-');
---

<Layout title={product.name} description={product.metaDescription || product.about}>
  <div class="page-hero">
    <div class="container">
      <p class="product-crumb">
        <a href="/products/">Products</a> / <a href={`/products/#${familyId}`}>{product.category}</a>
      </p>
      <div class="product-head">
        <img src={`/assets/icons/${product.icon}`} alt="" width="72" height="72" />
        <div>
          <h1>{product.name}</h1>
          <p class="hero-subtitle">{product.line}</p>
        </div>
      </div>
      {parent && <p class="product-parent">Part of <a href={`/products/${parent.slug}/`}>{parent.name}</a></p>}
    </div>
  </div>

  <section class="section section--alt">
    <div class="container product-body">
      <div class="product-main">
        <p class="product-about">{product.about}</p>
        {buttons.length > 0 && (
          <p class="product-btns">
            {buttons.map((b) => <a class="btn btn-primary btn-lg" href={b.href} rel="noopener">{b.label}</a>)}
          </p>
        )}
      </div>

      <section class="product-price" aria-labelledby="price-h">
        <h2 id="price-h">Price</h2>
        <!-- Price wording is the live page's own, held in src/data/products.json -->
        <Fragment set:html={product.priceHtml} />
      </section>
    </div>

    {siblings.length > 0 && (
      <div class="container product-more">
        <h2>More in {product.category}</h2>
        <nav class="sib-grid" aria-label={`More in ${product.category}`}>
          {siblings.map((s) => (
            <a class="sib" href={`/products/${s.slug}/`}>
              <img src={`/assets/icons/${s.icon}`} alt="" width="40" height="40" loading="lazy" />
              <span>{s.name}</span>
            </a>
          ))}
        </nav>
      </div>
    )}
  </section>

  <Footer />
</Layout>

<style is:global>
  /* The price block arrives as ready-made HTML, so its styles cannot be scoped. */
  .product-price p { color: #4b4d5d; line-height: 1.7; margin: 0 0 12px; }
  .product-price p.ph { font-family: var(--font-primary); font-size: 22px; line-height: 1.3; font-weight: 600; color: #0e1020; margin-bottom: 16px; }
  .product-price h3 { font-size: 17px; line-height: 1.3; font-weight: 600; color: #0e1020; margin: 24px 0 8px; }
  .product-price ul { list-style: disc; margin: 0 0 12px; padding-left: 20px; color: #4b4d5d; line-height: 1.7; }
  .product-price a { color: #1f57b3; text-decoration: underline; text-underline-offset: 3px; }
  .product-price a.btn {
    display: flex; text-align: center; background: #2f6fd5; color: #ffffff; text-decoration: none;
    padding: 14px 20px; line-height: 1.4; margin-top: 8px;
  }
  .product-price a.btn:hover { background: #1a5bb8; }
  .product-price p.btns { margin: 16px 0 0; display: grid; gap: 8px; }
</style>

<style>
  .product-crumb { font-size: 14px; color: #4b4d5d; margin: 0 0 24px; }
  .product-crumb a { color: #1f57b3; text-decoration: underline; text-underline-offset: 3px; }
  .product-head { display: flex; align-items: center; gap: 24px; }
  .product-head img { flex: none; width: 72px; height: 72px; border-radius: 16px; }
  .product-head h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.1; margin: 0 0 8px; }
  .product-head > div { min-width: 0; }
  .product-head h1 { overflow-wrap: anywhere; }
  @media (max-width: 480px) {
    .product-head { gap: 16px; }
    .product-head img { width: 52px; height: 52px; border-radius: 12px; }
    .product-head h1 { font-size: 26px; }
  }
  .product-parent { margin: 20px 0 0; font-size: 15px; color: #4b4d5d; }
  .product-parent a { color: #1f57b3; text-decoration: underline; text-underline-offset: 3px; }

  .product-body { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: start; }
  @media (min-width: 900px) { .product-body { grid-template-columns: 1.2fr 1fr; gap: 56px; } }
  .product-about { font-size: 20px; line-height: 1.6; color: #0e1020; margin: 0 0 28px; }
  .product-btns { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }
  .product-price { background: #ffffff; border: 1px solid #dcdce0; border-radius: 12px; padding: 28px; }
  .product-price h2 {
    font-size: 13px; line-height: 1.4; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: #4b4d5d; margin: 0 0 8px;
  }

  .product-more { margin-top: 72px; }
  .product-more h2 { font-size: clamp(22px, 3vw, 28px); line-height: 1.2; font-weight: 600; color: #0e1020; margin: 0 0 20px; }
  .sib-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .sib {
    display: flex; align-items: center; gap: 12px; padding: 12px 16px;
    background: #ffffff; border: 1px solid #dcdce0; border-radius: 10px;
    color: #0e1020; font-weight: 500; text-decoration: none;
  }
  .sib:hover { border-color: #2f6fd5; text-decoration: none; }
  .sib img { flex: none; width: 40px; height: 40px; border-radius: 8px; }
</style>
