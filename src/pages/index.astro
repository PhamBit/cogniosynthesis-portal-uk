---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import HeroMotion from '../components/Hero-Motion.astro';
import ServicesMotion from '../components/Services-Motion.astro';
import HomeUnderside from '../components/HomeUnderside.astro';
// Organisation details for search engines, as published on the live home page (read 27 Nov 2026).
import organization from '../data/organization-ld.json';

---

<BaseLayout 
  title="Home"
  fullTitle="Cogniosynthesis Portal — AI Exploration · AI Health Check · Epistemic Audit"
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(organization)} />
  <!-- HyperFrames Motion Hero (replaces static Hero) -->
  <HeroMotion 
    headline="Cogniosynthesis Portal"
    subheadline="We help organisations explore what AI could do for them, check the AI they already use, and see what their documents leave out. All on-site, all offline."
    primaryCta="Book a Conversation"
    primaryCtaLink="/contact/"
    secondaryCta="See the three ways we help"
    secondaryCtaLink="#ways"
    background="lens"
  />
  
  <!-- Animated Services Section -->
  <ServicesMotion />

  <!-- Everything below the three services: finding, also from us, documents, prices, who we are -->
  <HomeUnderside />
  
  <Footer />
</BaseLayout>

<!-- Global styles removed - now in components -->
<style>
</style>
