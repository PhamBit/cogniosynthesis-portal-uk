import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cookie Policy">
  <div class="container section">
    <h1>Cookie Policy</h1>
    
    <p><strong>Company:</strong> Cogniosynthesis Portal Ltd (trading as CognioNews, CognioEngine, FestivalFocus)</p>
    <p><strong>Company Number:</strong> 16225073</p>
    <p><strong>VAT Number:</strong> GB 531 4777 86</p>
    <p><strong>Registered in:</strong> England and Wales</p>
    <p><strong>Registered office:</strong> 15 Neptune Court, Vanguard Way, Cardiff CF24 5PJ</p>
    <p><strong>Data protection registration:</strong> ZC269688</p>
    <p><strong>Last reviewed:</strong> 2026-11-16</p>

    <h2 id="summary">Summary</h2>
    <p><strong>This site sets no cookies and runs no analytics.</strong></p>
    <p>You can browse our websites without giving us any personal data except what you choose to put in a form or an email.</p>

    <h2 id="what-is-a-cookie">What is a cookie?</h2>
    <p>A cookie is a small text file that a website stores on your device when you visit it. Cookies can help websites remember your preferences, analyse how people use the site, and deliver more relevant content.</p>

    <h2 id="what-we-do-not-use">What we do not use</h2>
    <p>We do <strong>not</strong> use:</p>
    <ul>
      <li>Analytics cookies (such as Google Analytics or similar tools)</li>
      <li>Advertising or marketing cookies</li>
      <li>Social media tracking pixels</li>
      <li>Third-party cookies for retargeting</li>
      <li>Cookies that track you across websites</li>
    </ul>

    <h2 id="what-we-might-use">What we might use</h2>
    <p>The only data we collect automatically are standard server log entries (your IP address, browser type, the pages you request, and when you requested them). These are kept for security and troubleshooting purposes for up to 15 days, and are not used to track you individually.</p>

    <h2 id="functional-data">Functional data</h2>
    <p>If you choose to subscribe to a newsletter, create an account, or contact us, we will collect the information you give us (name, email address, etc.). This is not done via cookies — it is collected when you submit the form. See our <a href="/privacy">Privacy Policy</a> for how we use and keep that data.</p>

    <h2 id="your-controls">Your controls</h2>
    <p>Because we do not use tracking or analytics cookies, there are no cookie preferences to adjust. You can use your browser's private / incognito mode if you prefer not to store any site data on your device.</p>

    <h2 id="changes">Changes to this policy</h2>
    <p>If we ever start using cookies that require consent, we will put a clear notice on the website and ask for your permission first.</p>

    <h2 id="contact">Contact us</h2>
    <p>If you have questions about this policy, email <a href="mailto:privacy@cogniosynthesisportal.uk">privacy@cogniosynthesisportal.uk</a>.</p>

    <hr />
    <p><strong>Document History:</strong></p>
    <table style="width: 100%; border-collapse: collapse;">
      <tr><th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Version</th><th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Date</th><th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Author</th><th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Changes</th></tr>
      <tr><td style="border: 1px solid #ddd; padding: 8px;">1.0</td><td style="border: 1px solid #ddd; padding: 8px;">2026-10-15</td><td style="border: 1px solid #ddd; padding: 8px;">Cogniosynthesis Portal Ltd</td><td style="border: 1px solid #ddd; padding: 8px;">Initial version — site uses no cookies or analytics</td></tr>
      <tr><td style="border: 1px solid #ddd; padding: 8px;">1.1</td><td style="border: 1px solid #ddd; padding: 8px;">2026-11-16</td><td style="border: 1px solid #ddd; padding: 8px;">Cogniosynthesis Portal Ltd</td><td style="border: 1px solid #ddd; padding: 8px;">Annual review; no changes.</td></tr>
    </table>

    <p><strong>Approval:</strong></p>
    <p>Kenny Lewis, Director<br />Approved: 5 November 2026</p>
  </div>
</BaseLayout>

<style>
  h1 { margin-bottom: var(--spacing-32); }
  h2 { margin-top: var(--spacing-48); margin-bottom: var(--spacing-16); }
