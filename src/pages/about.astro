---
import Layout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us" description="Learn about CognioSynthesis Portal">
  <div class="page-hero">
    <div class="container">
      <h1>About Us</h1>
      <p class="hero-subtitle">We deliver enterprise AI and technology solutions that transform businesses and drive outcomes at scale</p>
    </div>
  </div>

  <section class="section section--alt">
    <div class="container">
      <h2>Our Mission</h2>
      <p>CognioSynthesis Portal Ltd. is a leader in enterprise AI and technology solutions. We partner with global organizations to harness the power of artificial intelligence, data analytics, and cloud infrastructure to drive measurable business outcomes.</p>
      
      <h2 class="heading-with-spacer">What We Do</h2>
      <p>Our team of experts delivers end-to-end solutions across four core areas:</p>
      
      <ul class="capabilities-list">
        <li><strong>AI Platform Development</strong> - Custom AI models, machine learning pipelines, and intelligent automation systems</li>
        <li><strong>Data Analytics & Intelligence</strong> - Advanced analytics, business intelligence, and predictive modeling</li>
        <li><strong>Cloud Infrastructure</strong> - Cloud migration, modernization, and managed services</li>
        <li><strong>Cybersecurity</strong> - Threat detection, compliance frameworks, and security operations</li>
      </ul>
      
      <h2 class="heading-with-spacer">Why Choose Us</h2>
      <div class="differentiators-grid">
        <div class="differentiator">
          <h3>Deep Expertise</h3>
          <p>Our team brings decades of combined experience in enterprise technology and AI innovation.</p>
        </div>
        <div class="differentiator">
          <h3>Proven Track Record</h3>
          <p>We've delivered transformative solutions for organizations across multiple industries.</p>
        </div>
        <div class="differentiator">
          <h3>Outcome-Focused</h3>
          <p>We measure success by the business value we deliver, not just technical delivery.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
